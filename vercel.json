{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cron/daily.js": { "maxDuration": 300 },
    "api/telegram/webhook.js": { "maxDuration": 300 },
    "api/discord/interactions.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 16 * * *" },
    { "path": "/api/cron/daily", "schedule": "0 17 * * *" }
  ]
}